<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>NotinhasIcon</string>
	<key>CFBundleName</key>
	<string>$(NOTINHAS_BUNDLE_NAME)</string>
	<!-- Debug can still be opened explicitly, but must not claim image files in Finder. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mourato.notinhas</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>notinhas</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Notinhas needs microphone access to record audio with your screen recordings.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Notinhas needs screen recording permission to capture screenshots and record your screen.</string>
</dict>
</plist>
