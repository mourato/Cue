#!/bin/bash
# Get staged Swift files (ignoring deleted ones)
staged_swift_files=()
while IFS= read -r staged_path; do
  staged_swift_files[${#staged_swift_files[@]}]="$staged_path"
done < <(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$')

if [ "${#staged_swift_files[@]}" -eq 0 ]; then
  exit 0
fi

if which swiftformat >/dev/null; then
  echo "Validating staged Swift files..."
  swiftformat "${staged_swift_files[@]}" --lint
else
  echo "error: SwiftFormat is required for Swift commits." >&2
  exit 1
fi
