        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Worker 経由で直接共有します。UPLOAD_TOKEN はキーチェーンに保存されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Cloudflare Worker를 통해 직접 공유합니다. UPLOAD_TOKEN은 키체인에 보관됩니다." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Прямая публикация через ваш Cloudflare Worker. UPLOAD_TOKEN хранится в связке ключей." } },
