    "cloud-settings.cloudflare-description" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Direktes Teilen über deinen Cloudflare Worker. Das UPLOAD_TOKEN bleibt im Schlüsselbund." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Direct sharing through your Cloudflare Worker. The UPLOAD_TOKEN stays in Keychain." } },
